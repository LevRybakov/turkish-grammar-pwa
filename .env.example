# Firebase Web App Configuration (получите в Firebase Console -> Project Settings -> Your apps)
# Для облачной сборки на GitHub Pages добавьте эти же переменные в:
# GitHub Repository -> Settings -> Secrets and variables -> Actions -> Variables (или Secrets)

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
